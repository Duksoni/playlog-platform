  "query": "\n                SELECT id, name, released, draft\n                FROM games JOIN game_publishers gp ON gp.game_id = games.id\n                WHERE gp.publisher_id = $1 AND games.draft = false\n                ORDER BY name\n                LIMIT 10\n                OFFSET $2\n            ",
