{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT u.id, username, version\n                FROM users u\n                         JOIN user_roles ur ON ur.user_id = u.id\n                         JOIN roles r ON r.id = ur.role_id\n                WHERE u.id != $1 AND username ILIKE $2 ESCAPE '\\'\n                  AND account_status = 'ACTIVE'\n                  AND r.name = $3\n                ORDER BY username\n                LIMIT 50\n            ",
