USERS_DB_PASSWORD="your_users_db_password_here"
DATABASE_URL="postgresql://playlog_user:${USERS_DB_PASSWORD}@postgres_users:5432/users_db"

JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem

ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_USERNAME=your_admin_username
ADMIN_EMAIL=admin@example.com
ADMIN_TEMP_PASSWORD=your_admin_temp_password_here

RUST_LOG=user_service=warn,tower_http=info,axum=warn
